<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.CompartilharFragment">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCompartilhar"
            android:layout_width="0dp"
            android:layout_height="350dp"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_medium"
            android:fadeScrollbars="false"
            android:minHeight="250dp"
            android:padding="@dimen/padding_xsmall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/imageButtonCompartilhar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textInputLayout"
            app:srcCompat="@drawable/ic_share_24"
            app:tint="?attr/colorOnSurface"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="@dimen/margin_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewCompartilhar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nomeArquivoCompartilhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/compartilhar_hint"
                android:inputType="textShortMessage" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:id="@+id/divider10"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="@+id/recyclerCompartilhar"
            app:layout_constraintStart_toStartOf="@+id/recyclerCompartilhar"
            app:layout_constraintTop_toBottomOf="@+id/recyclerCompartilhar" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/recyclerCompartilhar"
            app:layout_constraintEnd_toEndOf="@+id/recyclerCompartilhar"
            app:layout_constraintStart_toStartOf="@+id/recyclerCompartilhar" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/recyclerCompartilhar"
            app:layout_constraintEnd_toStartOf="@+id/recyclerCompartilhar"
            app:layout_constraintTop_toTopOf="@+id/recyclerCompartilhar" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/recyclerCompartilhar"
            app:layout_constraintStart_toEndOf="@+id/recyclerCompartilhar"
            app:layout_constraintTop_toTopOf="@+id/recyclerCompartilhar" />

        <TextView
            android:id="@+id/textViewCompartilhar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_medium"
            android:foregroundGravity="left|center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider10" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>